# Copy to .env.local for a personal override, or set these in your hosting
# platform's build environment variables. Create React App bakes REACT_APP_*
# variables into the JS bundle at build time — they are not secret once
# built, so never put a real secret (only a client-safe key) in here.

# Base URL the frontend calls for the API. Defaults to the local backend
# when unset — override to point at your deployed backend.
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Mapbox public token, used for building autocomplete, geocoding, and
# walking directions. Get one at https://account.mapbox.com/. This is a
# client-side public token by design (Mapbox scopes it via URL/referrer
# restrictions in their dashboard, not by keeping it secret).
REACT_APP_MAPBOX_TOKEN=
